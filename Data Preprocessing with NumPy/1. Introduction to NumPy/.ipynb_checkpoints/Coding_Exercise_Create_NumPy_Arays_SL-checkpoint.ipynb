    "import numpy as np\n",
    "\n",
    "# 1D array of all even integers\n",
    "arr_1d = np.array([2,4,6,8])\n",
    "\n",
    "# 2D matrix 2x3\n",
    "arr_2d = np.array([[0,1,0],[1,0,1]])\n",
    "\n",
    "# Print the array and matrix\n",
    "print(\"1D Array:\")\n",
    "print(arr_1d)\n",
    "\n",
    "print(\"\\n2D Matrix:\")\n",
    "print(arr_2d)"
